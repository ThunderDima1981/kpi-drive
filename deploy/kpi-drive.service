[Unit]
Description=KPI-Drive API
After=network.target postgresql.service

[Service]
Type=simple
User=kpiapp
WorkingDirectory=/opt/kpi-drive
Environment=NODE_ENV=production
EnvironmentFile=/opt/kpi-drive/.env
ExecStart=/opt/kpi-drive/node_modules/.bin/tsx server/index.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
